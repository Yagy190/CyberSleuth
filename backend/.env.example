# Environment variables for CyberSleuth backend
# Copy this file to .env and fill in your values.

# ── Database ───────────────────────────────────────────────────────────────────
DB_URL=postgresql+psycopg2://cyber:secret@db:5432/cyber_sleuth

# ── Auth ───────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_generate_a_32char_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM / RAG ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=                 # leave empty to use MOCK_LLM
MOCK_LLM=true
EMBED_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5

# ── App ────────────────────────────────────────────────────────────────────────
DEBUG=false
